{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdTAO account context",
  "description": "Written by the adtao-setup skill; read by every AdTAO skill. One file per Google Ads account.",
  "type": "object",
  "required": ["customer_id"],
  "properties": {
    "customer_id": {"type": "string", "pattern": "^[0-9]{10}$"},
    "account_name": {"type": "string"},
    "currency": {"type": "string"},
    "economics": {
      "type": "object",
      "properties": {
        "lead_value": {"type": ["number", "null"]},
        "margin_pct": {"type": ["number", "null"]},
        "break_even_cpl": {"type": ["number", "null"]},
        "break_even_roas": {"type": ["number", "null"]}
      }
    },
    "goal": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["target_cpl", "target_roas", "volume_at_budget", "unknown"]},
        "value": {"type": ["number", "null"]},
        "in_users_words": {"type": "string"}
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "monthly": {"type": ["number", "null"]},
        "owner": {"type": "string"}
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "area_type": {"enum": ["city", "suburban", "rural", "mixed", "unknown"]}
        }
      }
    },
    "brand_rules": {
      "type": "object",
      "properties": {
        "never_use": {"type": "array", "items": {"type": "string"}},
        "never_name_competitors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "approver": {"type": "string"},
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {"type": "string"},
          "role": {"enum": ["agency", "client"]}
        }
      }
    },
    "reporting": {
      "type": "object",
      "description": "For the client report: what results are called, this quarter's plan and next month's.",
      "properties": {
        "result_label": {"enum": ["leads", "sales", "calls", "bookings", "conversions"]},
        "strategy": {"type": "string", "description": "This quarter's plan, in the account manager's words."},
        "planned_updates": {"type": "array", "items": {"type": "string"}},
        "audience": {"enum": ["owner", "marketing_lead"]}
      }
    },
    "updated": {"type": "string", "format": "date"}
  }
}
